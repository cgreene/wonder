# Copy to .env and fill in. .env is gitignored.

# Bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_BOT_TOKEN=

# The server (guild) ID where rooms get created.
# Enable Developer Mode in Discord (Settings -> Advanced), then right-click the
# server icon -> Copy Server ID.
DISCORD_GUILD_ID=

# Optional: a category (channel group) ID to nest rooms under. Right-click a
# category -> Copy Channel ID. Leave blank to create rooms at the top level.
DISCORD_CATEGORY_ID=

# Port for the HTTP service (src/server.js).
PORT=8787

# A room is auto-deleted after this many hours of no activity. Set to 0 to reap
# ALL OhWow rooms (useful for resetting between demo runs via `npm run reap`).
ROOM_TTL_HOURS=24

# How often the server's background reaper checks for idle rooms.
REAP_INTERVAL_MINUTES=60
